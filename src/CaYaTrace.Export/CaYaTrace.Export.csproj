<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CaYaTrace.Export</RootNamespace>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />

    <!-- CSV cell encoding is a security control (spreadsheet formula injection) and is
         worth testing directly, without making it part of the public surface. -->
    <InternalsVisibleTo Include="CaYaTrace.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CaYaTrace.Core\CaYaTrace.Core.csproj" />
    <ProjectReference Include="..\CaYaTrace.Storage\CaYaTrace.Storage.csproj" />
    <ProjectReference Include="..\CaYaTrace.Analysis\CaYaTrace.Analysis.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Templates\**\*.html" />
    <EmbeddedResource Include="Templates\**\*.css" />
  </ItemGroup>

</Project>
