<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Console subsystem, not Windows. A WinExe has no console attached, so piping,
      exit codes, and `&&` chaining all break for the CLI verbs — which is how this
      tool gets driven from sandbox automation. The workbench hides the console
      window on startup instead; a brief flash is a far smaller cost than a CLI the
      shell does not wait for.
    -->
    <OutputType>Exe</OutputType>
    <RootNamespace>CaYaTrace.App</RootNamespace>
    <AssemblyName>CaYaTrace</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!--
      Generated by tools/icon/make-icon.ps1 from the same geometry as the workbench
      header mark, so the two cannot drift. Regenerate rather than editing the .ico.
    -->
    <ApplicationIcon>Assets\cayatrace.ico</ApplicationIcon>

    <!-- Shown in the file's Details tab and by anything that reads version info. -->
    <Product>CaYaTrace</Product>
    <Company>CaYaDev</Company>
    <Authors>CaYaDev</Authors>
    <Description>Windows application forensics — installation monitoring, network analysis, and causal correlation in one portable tool.</Description>
    <Copyright>Copyright (c) CaYaDev</Copyright>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CaYaTrace.Core\CaYaTrace.Core.csproj" />
    <ProjectReference Include="..\CaYaTrace.Storage\CaYaTrace.Storage.csproj" />
    <ProjectReference Include="..\CaYaTrace.Collectors\CaYaTrace.Collectors.csproj" />
    <ProjectReference Include="..\CaYaTrace.Analysis\CaYaTrace.Analysis.csproj" />
    <ProjectReference Include="..\CaYaTrace.Remediation\CaYaTrace.Remediation.csproj" />
    <ProjectReference Include="..\CaYaTrace.Fleet\CaYaTrace.Fleet.csproj" />
    <ProjectReference Include="..\CaYaTrace.Export\CaYaTrace.Export.csproj" />
  </ItemGroup>

  <!--
    The UI is embedded so the host stays a single portable file, and so the exported
    HTML report is rendered by exactly the same markup the workbench uses rather than
    a second implementation that drifts from it.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\workbench.html" LogicalName="CaYaTrace.Assets.workbench.html" />
    <EmbeddedResource Include="Assets\theme.css" LogicalName="CaYaTrace.Assets.theme.css" />
    <EmbeddedResource Include="Assets\strings.json" LogicalName="CaYaTrace.Assets.strings.json" />

    <!--
      Embedded as well as set as ApplicationIcon. ApplicationIcon only stamps the
      executable's shell icon; the window needs its own, and loading it from a resource
      keeps that working from a single-file bundle where no .ico exists on disk.
    -->
    <EmbeddedResource Include="Assets\cayatrace.ico" LogicalName="CaYaTrace.Assets.cayatrace.ico" />
  </ItemGroup>

</Project>
